{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "yoloMode": false,
  "doublePressToConfirm": true,
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "id_rsa": "deny",
      "id_ed25519": "deny",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws/credentials": "deny",
      "~/.pi/agent/auth.json": "deny"
    },
    "bash": {
      "*": "ask",
      "rm -rf *": "ask",
      "sudo *": "ask",
      "git push --force*": "ask",
      "git reset --hard*": "ask",
      "git clean *": "ask",
      "git restore *": "ask",
      "npm publish*": "ask",
      "pnpm publish*": "ask",
      "docker system prune*": "ask",
      "kubectl delete *": "ask",
      "terraform destroy*": "ask",
      "tofu destroy*": "ask"
    },
    "mcp": {
      "*": "ask",
      "mcp_status": "ask",
      "mcp_list": "allow",
      "mcp_search": "allow",
      "mcp_describe": "allow",
      "mcp_connect": "ask",
      "zikra:*save*": "ask",
      "zikra_*save*": "ask",
      "zikra:*log*": "ask",
      "zikra_*log*": "ask",
      "zikra:*promote*": "ask",
      "zikra_*promote*": "ask",
      "zikra:*delete*": "ask",
      "zikra_*delete*": "ask",
      "zikra:*create_token*": "ask",
      "zikra_*create_token*": "ask",
      "codebase-memory-mcp:*index*": "ask",
      "codebase_memory_*index*": "ask",
      "codebase-memory-mcp:*delete*": "ask",
      "codebase_memory_*delete*": "ask",
      "codebase-memory-mcp:*manage_adr*": "ask",
      "codebase_memory_*manage_adr*": "ask",
      "codebase-memory-mcp:*ingest*": "ask",
      "codebase_memory_*ingest*": "ask",
      "mcp-image:*": "ask",
      "mcp_image_*": "ask",
      "linear:save_*": "ask",
      "linear_save_*": "ask",
      "linear:create_*": "ask",
      "linear_create_*": "ask",
      "linear:update_*": "ask",
      "linear_update_*": "ask",
      "linear:delete_*": "ask",
      "linear_delete_*": "ask"
    },
    "external_directory": "ask"
  }
}
