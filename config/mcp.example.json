{
  "settings": {
    "toolPrefix": "short",
    "autoAuth": true,
    "directTools": false,
    "scriptMode": false,
    "outputGuard": true,
    "hostConfigDiscovery": "off"
  },
  "mcpServers": {
    "exa": {
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "!op read 'op://Shared/LocalEnvironment/MCP/EXA_API_KEY'"
      },
      "lifecycle": "lazy"
    },
    "tavily": {
      "url": "https://mcp.tavily.com/mcp",
      "auth": "oauth",
      "lifecycle": "lazy"
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp",
      "auth": "oauth",
      "lifecycle": "lazy"
    },
    "codebase-memory-mcp": {
      "command": "codebase-memory-mcp",
      "lifecycle": "lazy-keep-alive"
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "!op read 'op://Shared/LocalEnvironment/CONTEXT7_API_KEY'"
      },
      "lifecycle": "lazy"
    },
    "figma": {
      "command": "/bin/sh",
      "args": [
        "${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/runtime/figma-mcp/launch.sh"
      ],
      "env": {
        "DO_NOT_TRACK": "1",
        "IMAGE_DIR": "${FIGMA_IMAGE_DIR}"
      },
      "lifecycle": "lazy-keep-alive"
    },
    "mcp-image": {
      "command": "/bin/sh",
      "args": [
        "${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/runtime/mcp-image/launch.sh"
      ],
      "env": {
        "IMAGE_INPUT_DIR": "${MCP_IMAGE_INPUT_DIR}",
        "IMAGE_OUTPUT_DIR": "${MCP_IMAGE_OUTPUT_DIR}",
        "IMAGE_QUALITY": "balanced"
      },
      "lifecycle": "lazy-keep-alive"
    },
    "zikra": {
      "url": "http://127.0.0.1:8377/mcp",
      "auth": "bearer",
      "bearerToken": "!op read 'op://Shared/LocalEnvironment/MCP/ZIKRA_PI_TOKEN'",
      "headers": {
        "X-Zikra-Runner": "!hostname -s"
      },
      "lifecycle": "lazy-keep-alive",
      "requestTimeoutMs": 10000,
      "approveTools": [
        "zikra_create_token",
        "zikra_delete_memory",
        "zikra_log_error",
        "zikra_log_run",
        "zikra_promote_requirement",
        "zikra_save_memory",
        "zikra_save_prompt",
        "zikra_save_requirement"
      ]
    },
    "paperclip": {
      "command": "/bin/sh",
      "args": [
        "${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/runtime/paperclip-mcp/launch.sh"
      ],
      "lifecycle": "lazy-keep-alive",
      "requestTimeoutMs": 120000,
      "exposeResources": false,
      "includeTools": [
        "paperclipListAgents",
        "paperclipGetAgent",
        "paperclipListIssues",
        "paperclipGetIssue",
        "paperclipGetHeartbeatContext",
        "paperclipListComments",
        "paperclipGetComment",
        "paperclipListIssueApprovals",
        "paperclipListDocuments",
        "paperclipGetDocument",
        "paperclipListDocumentRevisions",
        "paperclipListProjects",
        "paperclipGetProject",
        "paperclipGetIssueWorkspaceRuntime",
        "paperclipControlIssueWorkspaceServices",
        "paperclipWaitForIssueWorkspaceService",
        "paperclipListGoals",
        "paperclipGetGoal",
        "paperclipListApprovals",
        "paperclipCreateApproval",
        "paperclipGetApproval",
        "paperclipGetApprovalIssues",
        "paperclipListApprovalComments",
        "paperclipCreateIssue",
        "paperclipUpdateIssue",
        "paperclipCheckoutIssue",
        "paperclipReleaseIssue",
        "paperclipAddComment",
        "paperclipSuggestTasks",
        "paperclipAskUserQuestions",
        "paperclipRequestConfirmation",
        "paperclipRequestCheckboxConfirmation",
        "paperclipUpsertIssueDocument",
        "paperclipRestoreIssueDocumentRevision",
        "paperclipLinkIssueApproval",
        "paperclipUnlinkIssueApproval",
        "paperclipApprovalDecision",
        "paperclipAddApprovalComment"
      ],
      "approveTools": [
        "paperclipControlIssueWorkspaceServices",
        "paperclipCreateApproval",
        "paperclipCreateIssue",
        "paperclipUpdateIssue",
        "paperclipCheckoutIssue",
        "paperclipReleaseIssue",
        "paperclipAddComment",
        "paperclipSuggestTasks",
        "paperclipAskUserQuestions",
        "paperclipRequestConfirmation",
        "paperclipRequestCheckboxConfirmation",
        "paperclipUpsertIssueDocument",
        "paperclipRestoreIssueDocumentRevision",
        "paperclipLinkIssueApproval",
        "paperclipUnlinkIssueApproval",
        "paperclipApprovalDecision",
        "paperclipAddApprovalComment"
      ]
    }
  }
}
